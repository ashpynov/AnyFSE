  <ItemGroup>
    <None Include="Assets\localization\*.json" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="src\AppInstaller\Installer.rc">
        <PreprocessorDefinitions Condition="'$(Offline)'=='Offline'">
            OFFLINE_INSTALLER;
            BUILD_ARCHIVE=\"$(OutDir.Replace('\', '\\'))$(AssemblyProduct).$(AssemblyVersion).cab\";
            %(PreprocessorDefinitions)
        </PreprocessorDefinitions>
      <AdditionalOptions>/v /I&quot;$(ProjectDir)src\Installer&quot;/I&quot;$(ProjectDir)src&quot;</AdditionalOptions>
    </ResourceCompile>
  </ItemGroup>

  <!-- Run after solution dependencies, before compiling the embedded offline archive. -->
  <Target Name="CreateInstallerArchives" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <ApplicationFiles Include="$(OutDir)AnyFSE.exe" />
      <ApplicationFiles Include="$(OutDir)AnyFSE.Settings.dll" />
      <ApplicationFiles Include="$(OutDir)AnyFSE.ACSEFilterHook.dll" />
      <ApplicationFiles Include="$(OutDir)AnyFSE.ACSEFilterInjector.exe" />
      <ApplicationFiles Include="$(OutDir)unins000.exe" />
      <ApplicationFiles Include="$(MSBuildProjectDirectory)\Artem.Shpynov.cer;$(OutDir)$(AssemblyProduct)-$(AssemblyVersion).identity.appx" />
      <PackageContent Include="$(PackageDir)\**\*" />
      <PayloadLocalization Include="$(MSBuildProjectDirectory)\localization\*.json" />
      <ApplicationDumpFiles Include="$(OutDir)AnyFSE*.pdb" Exclude="$(OutDir)AnyFSE*-*.pdb" />
    </ItemGroup>
    <Error Condition="!Exists('%(ApplicationFiles.Identity)')" Text="Required installer file is missing: %(ApplicationFiles.Identity)" />
    <Error Condition="!Exists('$(PackageDir)\AppxManifest.xml') Or !Exists('$(PackageDir)\resources.pri')"
           Text="Fresh package contents are missing. Run the Package task before building the installer." />
    <Error Condition="'@(PayloadLocalization)' == ''" Text="No source localization files were found." />
    <RemoveDir Directories="$(PayloadDir)" />
    <MakeDir Directories="$(PayloadDir)" />
    <Copy SourceFiles="@(ApplicationFiles)" DestinationFolder="$(PayloadDir)" />
    <Copy SourceFiles="@(PackageContent)"
          DestinationFiles="@(PackageContent->'$(PayloadDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(PayloadLocalization)" DestinationFolder="$(PayloadDir)\Localization" />
    <PropertyGroup>
      <CabinetOutputDir>$([System.IO.Path]::GetFullPath('$(OutDir)'))</CabinetOutputDir>
      <PayloadCabinetDdf>$(IntDir)payload.ddf</PayloadCabinetDdf>
      <PDBFiles>@(ApplicationDumpFiles-&gt;'&quot;%(Filename)%(Extension)&quot;', ' ')</PDBFiles>
    </PropertyGroup>
    <MakeDir Directories="$(IntDir)" />
    <ItemGroup>
      <PayloadArchiveEntries Include="$(PayloadDir)\**\*" />
      <CabinetDirectives Include=".OPTION EXPLICIT" />
      <CabinetDirectives Include=".Set Cabinet=ON" />
      <CabinetDirectives Include=".Set Compress=ON" />
      <CabinetDirectives Include=".Set CompressionType=LZX" />
      <CabinetDirectives Include=".Set CompressionMemory=21" />
      <CabinetDirectives Include=".Set MaxDiskSize=0" />
      <CabinetDirectives Include=".Set MaxCabinetSize=0" />
      <CabinetDirectives Include=".Set FolderSizeThreshold=0" />
      <CabinetDirectives Include=".Set InfFileName=NUL" />
      <CabinetDirectives Include=".Set RptFileName=NUL" />
    </ItemGroup>
    <WriteLinesToFile File="$(PayloadCabinetDdf)" Overwrite="true" Encoding="ASCII"
      Lines="@(CabinetDirectives);.Set CabinetNameTemplate=$(AssemblyProduct).$(AssemblyVersion).cab;@(PayloadArchiveEntries->'&quot;%(RecursiveDir)%(Filename)%(Extension)&quot; &quot;%(RecursiveDir)%(Filename)%(Extension)&quot;')" />
    <Exec Command="&quot;$(SystemRoot)\System32\makecab.exe&quot; /D &quot;DiskDirectoryTemplate=$(CabinetOutputDir).&quot; /F &quot;$([System.IO.Path]::GetFullPath('$(PayloadCabinetDdf)'))&quot;" WorkingDirectory="$(PayloadDir)" />
    <Exec Command="tar -a -cf &quot;$(AssemblyProduct).$(AssemblyVersion).pdb.zip&quot; $(PDBFiles)" WorkingDirectory="$(OutDir)" />
  </Target>

  <Target Name="CleanInstallerStaging" AfterTargets="Build">
    <RemoveDir Directories="$(PayloadDir)" />
  </Target>

    <!-- Target: Get certificate thumbprint by name -->
    <Target Name="GetCertificateThumbprint">
        <Message Text="Finding certificate for: $(AssemblyCompany)" Importance="high" />

        <Exec Command="powershell -NoProfile -Command &quot;try { $cert = Get-ChildItem -Path 'Cert:\CurrentUser\My' | Where-Object { $_.Subject -like '*$(AssemblyCompany)*' -and -not $_.Extensions.CertificateAuthority } | Select-Object -First 1; if (-not $cert) { throw 'Certificate not found' }; $cert.Thumbprint } catch { Write-Error $_.Exception.Message; exit 1 }&quot;" ContinueOnError="false" ConsoleToMSBuild="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="CertificateThumbprint" />
        </Exec>

        <Message Text="Found certificate thumbprint: $(CertificateThumbprint)" Importance="high" />
    </Target>

    <!-- Target: Sign the EXE -->
    <Target Name="BuildSigned" DependsOnTargets="Build;GetCertificateThumbprint">
        <Message Text="Signing EXE with certificate: $(CertificateThumbprint)" Importance="high" />

        <!-- Run SignTool with the found certificate thumbprint -->
        <Exec Command="&quot;$(SignToolExe)&quot; sign /sha1 &quot;$(CertificateThumbprint)&quot; /fd SHA256 /a &quot;$(OutExe)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />

        <Message Text="EXE signed successfully: $(OutExe)" Importance="high" />
    </Target>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
