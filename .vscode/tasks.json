{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "cmd.exe",
                "args": [
                    "/C",
                    // The path to VsDevCmd.bat depends on the version of Visual Studio you have installed.
                    "\"C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\Common7\\Tools\\VsDevCmd.bat\"",
                    "&&"
                ]
            }
        }
    },
    "tasks": [
        {
            "type": "shell",
            "label": "Build AnyFSE Release",
            "command": "msbuild.exe",
            "args": [
                "AnyFSE.sln",
                "-property:Configuration=Release",
                "-property:Platform=x64",
                "-target:AnyFSE;AnyFSE_Settings;AnyFSE_ACSEFilterHook;AnyFSE_ACSEFilterInjector"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "Clean Debug",
            "command": "msbuild.exe",
            "args": [
                "AnyFSE.sln",
                "-property:Configuration=Debug",
                "-property:Platform=x64",
                "-target:Clean"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "Build AnyFSE Debug",
            "command": "msbuild.exe",
            "args": [
                "AnyFSE.sln",
                "-property:Configuration=Debug",
                "-property:Platform=x64",
                "-target:AnyFSE;AnyFSE_Settings;AnyFSE_ACSEFilterHook;AnyFSE_ACSEFilterInjector"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Program with Coverage",
            "type": "shell",
            "command": "C:\\Progra~1\\OpenCppCoverage\\OpenCppCoverage.exe",
            "args": [
                "--sources",
                "${workspaceFolder}",
                "--export_type",
                "cobertura:${workspaceFolder}\\coverage.xml",
                "--",
                "${workspaceFolder}\\build\\Debug\\AnyFSE.exe"
            ],
            "dependsOn": [
                "Build AnyFSE Debug"
            ],
            "group": "none"
        },
        {
            "type": "shell",
            "label": "Build AnyFSE.Installer Release",
            "command": "msbuild.exe",
            "args": [
                "AnyFSE.Installer.vcxproj",
                "-property:Configuration=Release",
                "-property:Platform=x64"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "Build AnyFSE.Installer Offline",
            "command": "msbuild.exe",
            "args": [
                "AnyFSE.Installer.vcxproj",
                "-property:Offline=Offline",
                "-property:Configuration=Release",
                "-property:Platform=x64"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "Build AnyFSE.Installer Offline and check with VirusTotal",
            "command": "powershell.exe",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\Test-VirusTotal.ps1"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "Build AnyFSE.Installer Offline"
            ]
        },
        {
            "type": "shell",
            "label": "Build AnyFSE.Installer Debug",
            "command": "msbuild.exe",
            "args": [
                "AnyFSE.Installer.vcxproj",
                "-property:Configuration=Debug",
                "-property:Offline=Offline",
                "-property:Platform=x64"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "Build AnyFSE.Uninstaller Debug",
            "command": "msbuild.exe",
            "args": [
                "AnyFSE.Uninstaller.vcxproj",
                "-property:Configuration=Debug",
                "-property:Platform=x64"
            ],
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "type": "shell",
            "label": "Build AnyFSE.Uninstaller Release",
            "command": "msbuild.exe",
            "args": [
                "AnyFSE.Uninstaller.vcxproj",
                "-property:Configuration=Release",
                "-property:Platform=x64"
            ],
            "problemMatcher": [
                "$msCompile"
            ]
        }
    ]
}
