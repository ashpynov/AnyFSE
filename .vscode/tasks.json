{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "cmd.exe",
                "args": [
                    "/C",
                    "call \"${workspaceFolder}\\scripts\\Enter-VSDeveloperEnvironment.cmd\"",
                    "&&"
                ]
            }
        }
    },
    "tasks": [
        {
            "label": "Build AnyFSE Release Unsigned",
            "type": "shell",
            "command": "msbuild.exe",
            "args": [
                "AnyFSE.sln", "-property:Configuration=Release", "-property:Platform=x64",
                "-property:SignBinaries=false",
                "-target:AnyFSE;AnyFSE_Settings;AnyFSE_ACSEFilterHook;AnyFSE_ACSEFilterInjector"
            ],
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Build AnyFSE Debug Isolated",
            "type": "shell",
            "command": "msbuild.exe",
            "args": [
                "AnyFSE.sln", "-property:Configuration=Debug", "-property:Platform=x64",
                "-property:OutDir=build\\Debug-Isolated\\",
                "-target:AnyFSE;AnyFSE_Settings;AnyFSE_ACSEFilterHook;AnyFSE_ACSEFilterInjector"
            ],
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Prepare Optimization Tests",
            "type": "shell",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-Command", "New-Item -ItemType Directory -Force build/tests | Out-Null"],
            "problemMatcher": []
        },
        {
            "label": "Build Optimization Tests",
            "type": "shell",
            "command": "cl.exe",
            "args": [
                "/nologo", "/std:c++17", "/EHsc", "/W4", "/I", "src",
                "/Fo:build/tests/OptimizationSessionTests.obj",
                "/Fe:build/tests/OptimizationSessionTests.exe", "tests/OptimizationSessionTests.cpp"
            ],
            "dependsOn": ["Prepare Optimization Tests"],
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Test Optimization Recovery",
            "type": "shell",
            "command": "${workspaceFolder}\\build\\tests\\OptimizationSessionTests.exe",
            "dependsOn": ["Build Optimization Tests"],
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Build AnyFSE Release",
            "command": "msbuild.exe",
            "args": [
                "AnyFSE.sln",
                "-property:Configuration=Release",
                "-property:Platform=x64",
                "-target:AnyFSE;AnyFSE_Settings;AnyFSE_ACSEFilterHook;AnyFSE_ACSEFilterInjector"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "shell",
            "label": "Clean Debug",
            "command": "msbuild.exe",
            "args": [
                "AnyFSE.sln",
                "-property:Configuration=Debug",
                "-property:Platform=x64",
                "-target:Clean"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "shell",
            "label": "Build AnyFSE Debug",
            "command": "msbuild.exe",
            "args": [
                "AnyFSE.sln",
                "-property:Configuration=Debug",
                "-property:Platform=x64",
                "-target:AnyFSE;AnyFSE_Settings;AnyFSE_ACSEFilterHook;AnyFSE_ACSEFilterInjector"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Program with Coverage",
            "type": "shell",
            "command": "C:\\Progra~1\\OpenCppCoverage\\OpenCppCoverage.exe",
            "args": [
                "--sources",
                "${workspaceFolder}",
                "--export_type",
                "cobertura:${workspaceFolder}\\coverage.xml",
                "--",
                "${workspaceFolder}\\build\\Debug\\AnyFSE.exe"
            ],
            "dependsOn": [
                "Build AnyFSE Debug"
            ],
            "group": "none"
        },
        {
            "label": "Package",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "${workspaceFolder}/AnyFSE.sln",
                "/p:Configuration=Release",
                "/p:Platform=x64",
                "-target:AnyFSE_Package"
            ],
            "group": "build"
        },
        {
            "label": "Package Debug",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "${workspaceFolder}/AnyFSE.sln",
                "/p:Configuration=Debug",
                "/p:Platform=x64"
            ],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "Build AnyFSE.Installer Release",
            "command": "msbuild.exe",
            "args": [
                "AnyFSE.Installer.vcxproj",
                "-property:Configuration=Release",
                "-property:Platform=x64"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": [
                "Package"
            ]
        },
        {
            "type": "shell",
            "label": "Build AnyFSE.Installer Offline",
            "command": "msbuild.exe",
            "args": [
                "AnyFSE.Installer.vcxproj",
                "-property:Offline=Offline",
                "-property:Configuration=Release",
                "-property:Platform=x64"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": [
                "Package"
            ]
        },
        {
            "type": "shell",
            "label": "Build AnyFSE.Installer Offline and check with VirusTotal",
            "command": "powershell.exe",
            "args": [
                "-NoLogo",
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\Test-VirusTotal.ps1"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": [
                "Build AnyFSE.Installer Offline"
            ]
        },
        {
            "type": "shell",
            "label": "Build AnyFSE.Installer Debug",
            "command": "msbuild.exe",
            "args": [
                "AnyFSE.Installer.vcxproj",
                "-property:Configuration=Debug",
                "-property:Offline=Offline",
                "-property:Platform=x64"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "dependsOn": [
                "Package Debug"
            ]
        },
        {
            "type": "shell",
            "label": "Build AnyFSE.Uninstaller Release",
            "command": "msbuild.exe",
            "args": [
                "AnyFSE.Uninstaller.vcxproj",
                "-property:Configuration=Release",
                "-property:Platform=x64"
            ],
            "problemMatcher": [
                "$msCompile"
            ]
        }
    ]
}
